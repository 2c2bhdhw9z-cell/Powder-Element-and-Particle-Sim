<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Crucible</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<!-- Metal is not optional here: the simulation is drawn with it and there is no
		     fallback path. Stating it means the App Store will not offer the app to a
		     device that cannot run it. -->
		<string>metal</string>
	</array>
	<!-- An empty launch screen dictionary rather than a storyboard. Without one of the two
	     iOS runs the app in a compatibility mode that letterboxes it, which on a device
	     with rounded corners and an island looks broken. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<!-- The simulation fills the screen, so the status bar would sit on top of it. -->
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- Lets the app actually draw at the display's full rate.
	     Without this, iOS silently caps everything at 60 frames a second on a ProMotion
	     iPhone no matter what the app asks for — so a 120Hz screen runs at half speed and
	     the only clue is a frame interval of 16.7ms when the work took under one. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Nothing here switches the Metal performance overlay off. It is driven by iOS's own
	     developer settings and is left entirely under your control. -->
	<!-- The two typefaces the web version loads from Google's servers, bundled instead,
	     because an app has to look right with no network. Both are under the SIL Open Font
	     License; its text sits beside the files in App/Resources/Fonts.

	     A name missing from this list does not fail the build and does not crash: the app
	     just silently draws in the system face instead. LabFonts.missingFaces() checks for
	     that at runtime and the debug readout reports it. -->
	<!-- Required before iOS will hand over any motion reading. Without it the tilt control is
	     refused rather than merely unavailable, and the refusal is silent. -->
	<key>NSMotionUsageDescription</key>
	<string>Tilt your phone to change which way things fall, and shake it to rattle a pile loose.</string>
	<key>UIAppFonts</key>
	<array>
		<string>Syne-Medium.ttf</string>
		<string>Syne-SemiBold.ttf</string>
		<string>Syne-Bold.ttf</string>
		<string>IBMPlexSans-Regular.ttf</string>
		<string>IBMPlexSans-Medium.ttf</string>
		<string>IBMPlexSans-SemiBold.ttf</string>
		<string>IBMPlexMono-Regular.ttf</string>
		<string>IBMPlexMono-Medium.ttf</string>
	</array>
</dict>
</plist>
