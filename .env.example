# DATABASE_URL: Optional. Real Postgres (e.g. Neon) connection string.
# Unset means the app falls back to an embedded PGLite database (local/preview).
# NOTE: setting DATABASE_URL WITHOUT enabling auth (see VITE_AUTH_ENABLED plus
# the AUTH_* creds below) makes every per-user server function fail closed
# by design: the app refuses to share one local dev-user against a real
# database. Enable auth as well, or leave DATABASE_URL unset to run as a guest.
# DATABASE_URL="postgres://user:pass@host/db"

# VITE_AUTH_ENABLED: Optional. Auth is OFF by default; the lab runs as a guest
# with no external sign-in. Set to "true" only if you self-host federated login
# (you must also set the AUTH_* creds below). Enabling auth is required
# before pairing the app with a real DATABASE_URL (see the note above).
# VITE_AUTH_ENABLED="false"

# The vars below are ONLY needed if you set VITE_AUTH_ENABLED="true" and wire up
# your OWN OAuth provider. Leave them unset to run the lab as a guest.
# AUTH_ISSUER: OIDC issuer URL of your OAuth provider.
# AUTH_ISSUER=""
# AUTH_CLIENT_ID: OAuth client id from your provider.
# AUTH_CLIENT_ID=""
# AUTH_CLIENT_SECRET: OAuth client secret from your provider.
# AUTH_CLIENT_SECRET=""
# BETTER_AUTH_URL: Public URL where this app is served (for auth callbacks).
# BETTER_AUTH_URL=""
# BETTER_AUTH_SECRET: Random secret used to sign auth sessions.
# BETTER_AUTH_SECRET=""
